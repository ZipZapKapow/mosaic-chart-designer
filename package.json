{
  "name": "mosaic-chart-designer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Design overlay mosaic crochet charts in the browser and export them as PDFs.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  }
}
